// WayneTrade — Core Data Model (Phase 1 MVP)
// Reference: WayneTrade_Developer_Guide.docx, Section 4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id          String   @id @default(uuid())
  name        String
  adminUserId String   @map("admin_user_id")
  // Where the broker's batched research digest (Layer 2 output) is sent.
  // Null = digest is dashboard-only, no WhatsApp push.
  brokerWhatsappNumber String? @map("broker_whatsapp_number")
  createdAt   DateTime @default(now()) @map("created_at")

  members         Member[]
  strategies      Strategy[]
  killSwitches    KillSwitchEvent[] @relation("GroupKillSwitch")
  notifications   Notification[]
  researchSignals ResearchSignal[]

  @@map("groups")
}

// Layer 2 — AI research assistant output. One row per news article Claude
// actually analyzed, kept even at LOW confidence — the audit trail doesn't
// get to be selective about which findings it remembers. groupId null =
// platform-wide scan not tied to one broker/group.
model ResearchSignal {
  id            String   @id @default(uuid())
  groupId       String?  @map("group_id")
  headline      String
  sourceUrl     String?  @map("source_url")
  sector        String?
  bullCase      String   @map("bull_case")
  bearCase      String   @map("bear_case")
  riskNote      String   @map("risk_note")
  // LOW/MEDIUM/HIGH, the risk-supervisor role's verdict — deliberately a
  // tag, not an invented numeric score, matching forecast.py's rule that
  // confidence must come from something countable, never be guessed.
  confidenceTag String   @map("confidence_tag")

  // Forecast-engine cross-check (saaf-signal-backend's /signal/{ticker}) —
  // populated only when the article names a specific, resolvable ticker.
  // Deliberately kept as SEPARATE columns from confidenceTag above, never
  // merged into one number: the news read and the technical/historical
  // read are two different kinds of evidence, and showing them side by
  // side is the whole point of unifying these two engines. Null on every
  // field means either no ticker was identifiable or the forecast-engine
  // call failed/was skipped — the news-only analysis above still stands
  // on its own either way.
  ticker                  String? @map("ticker")
  technicalDirection      String? @map("technical_direction")
  technicalConfidence     Float?  @map("technical_confidence")
  technicalSampleSize     Int?    @map("technical_sample_size")
  technicalReliabilityTier String? @map("technical_reliability_tier")

  createdAt     DateTime @default(now()) @map("created_at")

  group Group? @relation(fields: [groupId], references: [id])

  @@map("research_signals")
}

model Member {
  id               String   @id @default(uuid())
  groupId          String   @map("group_id")
  userId           String   @map("user_id")
  brokerType       BrokerType @map("broker_type")
  // Tokenized reference only — never store raw broker credentials here.
  // Actual API keys/tokens live in a secrets manager (e.g. Railway/Vault),
  // this column just points to that secret.
  brokerAccountRef String   @map("broker_account_ref")
  riskProfileId    String?  @unique @map("risk_profile_id")
  status           MemberStatus @default(ACTIVE)
  // E.164 format (e.g. "+91XXXXXXXXXX"). Null = real-time WhatsApp trade
  // alerts are skipped for this member (dashboard feed row still written).
  whatsappNumber   String?  @map("whatsapp_number")
  createdAt        DateTime @default(now()) @map("created_at")

  group           Group @relation(fields: [groupId], references: [id])
  riskProfile     RiskProfile? @relation(fields: [riskProfileId], references: [id])
  riskDecisions   RiskDecision[]
  orders          Order[]
  killSwitchEvents KillSwitchEvent[] @relation("MemberKillSwitch")
  notifications   Notification[]

  @@map("members")
}

// Added to close a Phase 1 gap: lets each member run the same strategy at a
// different risk tolerance instead of a hardcoded fixed lot size for everyone.
model RiskProfile {
  id                  String   @id @default(uuid())
  fixedLots           Decimal  @default(0.01) @map("fixed_lots") @db.Decimal(10, 4)
  maxDailyLossPercent Decimal? @map("max_daily_loss_percent") @db.Decimal(5, 2)
  maxOpenPositions    Int?     @map("max_open_positions")
  // Auto profit-booking: take-profit distance from entry, as a multiple of
  // the stop-loss distance (e.g. 2.0 = book profit at 2x the risked amount).
  // Null disables auto profit-booking for this member — a signal's own
  // explicit takeProfit still applies either way.
  riskRewardRatio     Decimal? @default(2.0) @map("risk_reward_ratio") @db.Decimal(5, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  member Member?

  @@map("risk_profiles")
}

enum BrokerType {
  METATRADER
  KITE_CONNECT
}

enum MemberStatus {
  ACTIVE
  PAUSED
  REMOVED
}

model Strategy {
  id               String   @id @default(uuid())
  groupId          String   @map("group_id")
  name             String
  sourceType       SourceType @map("source_type")
  // AES-256-GCM ciphertext ("iv:authTag:ciphertext" hex), never plaintext.
  // A one-way hash (the original Phase 1 design) cannot work here — HMAC
  // signature verification needs the actual secret back, not a hash of it.
  // Decrypted at request time using ENCRYPTION_KEY (see src/services/encryption.js).
  webhookSecretEncrypted String  @map("webhook_secret_encrypted")
  // SEBI Algo-ID, assigned by the exchange once this strategy is registered
  // through an empanelled broker (there is no API to generate this — get it
  // from the broker after registration). Required before any KITE_CONNECT
  // (equities) member can trade this strategy; forex/MetaTrader strategies
  // don't need one. Null = equities orders on this strategy are rejected,
  // not silently sent untagged.
  algoId            String?  @map("algo_id")
  createdAt        DateTime @default(now()) @map("created_at")

  group   Group    @relation(fields: [groupId], references: [id])
  signals Signal[]

  @@map("strategies")
}

enum SourceType {
  PINE_SCRIPT
  CUSTOM
}

model Signal {
  id          String   @id @default(uuid())
  strategyId  String   @map("strategy_id")
  rawPayload  Json     @map("raw_payload")
  receivedAt  DateTime @default(now()) @map("received_at")
  validated   Boolean  @default(false)

  strategy      Strategy       @relation(fields: [strategyId], references: [id])
  riskDecisions RiskDecision[]

  @@map("signals")
}

model RiskDecision {
  id           String   @id @default(uuid())
  signalId     String   @map("signal_id")
  memberId     String   @map("member_id")
  action       RiskAction
  reason       String
  positionSize Decimal? @map("position_size") @db.Decimal(18, 4)
  takeProfit   Decimal? @map("take_profit") @db.Decimal(18, 4)
  createdAt    DateTime @default(now()) @map("created_at")

  signal Signal @relation(fields: [signalId], references: [id])
  member Member @relation(fields: [memberId], references: [id])
  order  Order?

  @@map("risk_decisions")
}

enum RiskAction {
  APPROVE
  REJECT
  RESIZE
}

model Order {
  id             String   @id @default(uuid())
  riskDecisionId String   @unique @map("risk_decision_id")
  memberId       String   @map("member_id")
  brokerOrderRef String?  @map("broker_order_ref")
  status         OrderStatus @default(PENDING)
  algoId         String?  @map("algo_id") // equities-only, SEBI Algo-ID
  // Kite Connect GTT trigger id covering this order's stop-loss/take-profit
  // (equities only — see kiteConnectBridge.js's placeProtectiveExit). Null
  // on a KITE_CONNECT order means the position is UNPROTECTED, not that
  // protection wasn't needed — check this before treating an equities
  // order as safe.
  protectiveTriggerRef String? @map("protective_trigger_ref")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  riskDecision RiskDecision @relation(fields: [riskDecisionId], references: [id])
  member       Member       @relation(fields: [memberId], references: [id])
  notifications Notification[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  SENT
  FILLED
  REJECTED
  CANCELLED
  ERROR
}

// Layer 3 — real-time transparency feed. One row per message actually
// generated (investor per-trade explanation, or broker research digest),
// persisted here as the dashboard's source of truth regardless of whether
// the WhatsApp push succeeded.
model Notification {
  id             String   @id @default(uuid())
  audience       NotificationAudience
  memberId       String?  @map("member_id") // set when audience = INVESTOR
  groupId        String?  @map("group_id")  // set when audience = BROKER
  orderId        String?  @map("order_id")  // set for per-trade investor messages
  message        String
  whatsappStatus NotificationDeliveryStatus @default(PENDING) @map("whatsapp_status")
  createdAt      DateTime @default(now()) @map("created_at")

  member Member? @relation(fields: [memberId], references: [id])
  group  Group?  @relation(fields: [groupId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@map("notifications")
}

enum NotificationAudience {
  INVESTOR
  BROKER
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  // Twilio not configured (TWILIO_* env vars unset) or member/group has no
  // WhatsApp number on file — message is still saved to the dashboard feed.
  SKIPPED_NOT_CONFIGURED
}

model KillSwitchEvent {
  id          String   @id @default(uuid())
  memberId    String?  @map("member_id")
  groupId     String?  @map("group_id")
  triggeredBy String   @map("triggered_by")
  triggeredAt DateTime @default(now()) @map("triggered_at")
  reason      String

  member Member? @relation("MemberKillSwitch", fields: [memberId], references: [id])
  group  Group?  @relation("GroupKillSwitch", fields: [groupId], references: [id])

  @@map("kill_switch_events")
}
