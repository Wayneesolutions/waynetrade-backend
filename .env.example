# Postgres (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Server
PORT=4000

# MetaApi.cloud (Phase 1 — forex/crypto execution bridge)
METAAPI_TOKEN=
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai

# App-level encryption key for strategies.webhookSecretEncrypted (AES-256-GCM).
# 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shared admin API key — required (header: X-Api-Key) for /kill-switch and
# /dashboard routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# HONEST LIMIT: one shared key for now, not per-user accounts/RBAC.
ADMIN_API_KEY=

# Kite Connect (equities/F&O execution bridge)
KITE_API_KEY=
KITE_API_SECRET=

# Twilio WhatsApp (Layer 3 — real-time trade/research notifications).
# Leave unset and the notification still gets written to the dashboard feed
# (notifications table) with whatsappStatus = SKIPPED_NOT_CONFIGURED — the
# WhatsApp push is best-effort, never a requirement for a trade to happen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format, e.g. "+14155238886" (Twilio's WhatsApp sandbox number in dev)
TWILIO_WHATSAPP_FROM=

# SEBI Algo-ID (equities orders only) — assigned per registered strategy,
# not set here. Once your broker registers a strategy with the exchange,
# save the Algo-ID they give you via PUT /onboarding/strategy/:id/algo-id.
# There is no API to generate it yourself, and no env var for it — a
# strategy with no Algo-ID has its equities orders rejected, not silently
# sent untagged (see kiteConnectBridge.js).

# Layer 2 — AI research assistant (news scanning + Claude analysis).
# Leave ANTHROPIC_API_KEY unset (and no `ant auth login` profile active) and
# POST /research/scan fails loudly rather than faking a result — see
# researchAssistant.js.
NEWS_API_KEY=
# Any NewsAPI.org-shaped endpoint: { articles: [{ title, description, url }] }.
NEWS_API_BASE_URL=https://newsapi.org/v2/everything
ANTHROPIC_API_KEY=
ANTHROPIC_RESEARCH_MODEL=claude-opus-5
