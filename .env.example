# Postgres (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Server
PORT=4000

# MetaApi.cloud (Phase 1 — forex/crypto execution bridge)
METAAPI_TOKEN=
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai

# Per-strategy webhook secrets (used for HMAC verification).
# One env var per strategy row, named STRATEGY_SECRET_<strategyId>.
# Example: STRATEGY_SECRET_abc123=supersecretvalue
# NEVER commit real values — this is why they live in env vars, not the DB.

# Kite Connect (Phase 3 — equities/F&O, not wired up yet)
KITE_API_KEY=
KITE_API_SECRET=
