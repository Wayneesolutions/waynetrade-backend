# Postgres (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Server
PORT=4000

# MetaApi.cloud (Phase 1 — forex/crypto execution bridge)
METAAPI_TOKEN=
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai

# App-level encryption key for strategies.webhookSecretEncrypted (AES-256-GCM).
# 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shared admin API key — required (header: X-Api-Key) for /kill-switch and
# /dashboard routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# HONEST LIMIT: one shared key for now, not per-user accounts/RBAC.
ADMIN_API_KEY=

# Per-user auth (JWT). Required for /auth login + user accounts. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Notifications — Telegram bot (optional; unset = notifications disabled).
# 1. Create a bot with @BotFather → token here.
# 2. Add the bot to your group chat, send a message, read the chat id from
#    https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kite Connect (Phase 3 — equities/F&O). The whole path is gated behind
# KITE_ENABLED=true; leave it off until broker Algo-ID registration and
# legal/compliance review are done. Access tokens expire DAILY and must be
# refreshed through Kite's interactive login flow — there is no headless
# renewal by design.
KITE_ENABLED=false
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=
# SEBI Algo-ID for order tagging — confirm the exact mechanism with the
# broker before real equities trading. Orders are refused without it.
KITE_ALGO_ID=
KITE_BASE_URL=https://api.kite.trade
