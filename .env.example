# Postgres (Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Server
PORT=4000

# MetaApi.cloud (Phase 1 — forex/crypto execution bridge)
METAAPI_TOKEN=
METAAPI_BASE_URL=https://mt-client-api-v1.new-york.agiliumtrade.ai

# App-level encryption key for strategies.webhookSecretEncrypted (AES-256-GCM).
# 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Shared admin API key — required (header: X-Api-Key) for /kill-switch and
# /dashboard routes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# HONEST LIMIT: one shared key for now, not per-user accounts/RBAC.
ADMIN_API_KEY=

# Kite Connect (Phase 3 — equities/F&O, not wired up yet)
KITE_API_KEY=
KITE_API_SECRET=
